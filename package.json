{
  "name": "web-blocks",
  "version": "1.0.0",
  "description": "A WebGL application for building worlds and learning programming",
  "private": true,
  "scripts": {
    "build": "webpack",
    "start": "http-server -p 8888",
    "test": "vitest run",
    "test:ui": "vitest run test/ui/sanity.test.ts",
    "profile": "tsx profile.ts",
    "size": "tsx size.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@types/three": "^0.185.4",
    "comlink": "^4.4.2",
    "react": "^19",
    "react-dom": "^19",
    "three": "^0.185.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "css-loader": "^7.1.4",
    "eslint": "^10.9.0",
    "globals": "^17.11.0",
    "http-server": "^14.1.1",
    "less": "^4.9.0",
    "less-loader": "^13.0.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.6.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "yarn@1.22.22",
  "repository": {
    "type": "git",
    "url": "git://github.com/cjdell/web-blocks.git"
  }
