{
  "name": "web-blocks",
  "version": "1.0.0",
  "description": "A WebGL application for building worlds and learning programming",
  "private": true,
  "scripts": {
    "build": "webpack",
    "start": "http-server -p 8888",
    "test": "tsx node_modules/mocha/bin/mocha.js test.ts",
    "test:ui": "tsx test/ui/sanity.ts",
    "profile": "tsx profile.ts",
    "size": "tsx size.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@types/three": "^0.185.4",
    "react": "^19",
    "react-dom": "^19",
    "three": "^0.185.1",
    "ws": "^8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10",
    "@types/node": "^25.9.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "chai": "^4.5.0",
    "css-loader": "^7.1.4",
    "eslint": "^9.39.2",
    "globals": "^16.5.0",
    "http-server": "^14.1.1",
    "less": "^4.6.4",
    "less-loader": "^13.0.0",
    "mocha": "^11.7.5",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "style-loader": "^4.0.0",
    "ts-loader": "^9",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.54.0",
    "webpack": "^5",
    "webpack-cli": "^7.0.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "yarn@1.22.22",
